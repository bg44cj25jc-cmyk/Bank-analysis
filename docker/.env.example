# Copy to .env beside compose.yml and set the secret before the first start.

# Shared secret on the worker protocol. Stops anything else on the LAN draining
# the queue. Not user authentication -- that arrives with roles.
#   openssl rand -hex 32
SB_WORKER_TOKEN=change-me

# Where the worker finds the API. Leave as-is for a single-machine deployment;
# point it at the NAS (e.g. http://192.168.1.10:8000) to run OCR on the desktop.
SB_API_URL=http://api:8000

# Concurrent OCR workers on this host. Two leaves cores for the API and DSM.
SB_WORKER_REPLICAS=2

# Whether a REJECT verdict blocks the upload outright. Off by default so the
# existing backlog of 150 DPI scans stays processable.
SB_REJECT_BLOCKS_UPLOAD=false

# Seconds before a job held by a vanished worker returns to the queue.
SB_CLAIM_TIMEOUT=3600

# --- Synology paths ------------------------------------------------------
# Database and job scratch on the NVMe pool; client PDFs on the encrypted
# shared folder that carries the snapshot schedule.
# SB_FAST_VOLUME=/volume2/nvme/statementbridge
# SB_ARCHIVE_VOLUME=/volume1/clients/statements

# --- desktop tier (compose.desktop.yml), optional -----------------------
# Only needed on the Ryzen desktop, not on the NAS.
# SB_ARCHIVE_MOUNT=/mnt/nas/clients/statements   # same share the NAS serves
# SB_SCRATCH_DIR=./scratch
# SB_STIRLING_CONFIG=./stirling/config
